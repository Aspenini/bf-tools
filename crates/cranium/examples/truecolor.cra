// Graphics with no runtime at all.
//
//     cranium truecolor.cra --run
//
// Nothing here talks to a library, a window, or a driver. It prints bytes to
// standard output, and the terminal - which is already a display, on every
// machine - turns them into pixels. The whole program still compiles to
// Brainfuck.
//
// `std/gfx.cra` walks the screen and asks for each pixel in turn; this file
// only has to answer. See that file for why there is no framebuffer.

import "std/gfx.cra";

// Called once per pixel, in scan order.
fn shade(x: byte, y: byte) {
    set_rgb(x * 4, y * 8, 255 - x * 4);
}

fn main() {
    present();
}
