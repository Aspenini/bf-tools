// lobotomy - an ahead-of-time Brainfuck compiler, written in Cranium.
//
// It reads a Brainfuck program on standard input and writes a complete C
// program on standard output, which any C compiler turns into a native
// executable:
//
//     cranium examples/lobotomy.cra -o lobotomy.bf
//     hypothalamus lobotomy.bf -o lobotomy --opt-level 1
//     ./lobotomy < sierpinski.bf > sierpinski.c
//     clang -O2 sierpinski.c -o sierpinski && ./sierpinski
//
// Like `hypothalamus`, it is an optimizing compiler rather than a
// transliterator. It folds runs of `+`, `-`, `>`, and `<` into single
// operations and recognizes `[-]` and `[+]` as "set the cell to zero", using a
// two-unit peephole window.
//
// It never stores the program. Everything happens in one streaming pass, so it
// compiles a Brainfuck program of any length - which matters, because reaching
// element `i` of a Cranium array costs on the order of `i` squared.

const KIND_NONE = 0;
const KIND_ADD = 1;
const KIND_SUB = 2;
const KIND_RIGHT = 3;
const KIND_LEFT = 4;
const KIND_OUT = 5;
const KIND_IN = 6;
const KIND_OPEN = 7;
const KIND_CLOSE = 8;
const KIND_CLEAR = 9;

// Longest run folded into one operation. Keeping it under 256 means a run
// count always fits comfortably, however pathological the input.
const RUN_MAX = 255;

const TAPE_CELLS = 30000;

// Brace depth in the emitted C. The body of `main` starts at one.
let depth = 1;
let open_loops: int = 0;
let unbalanced = false;

// The peephole window: two units that have been read but not yet written out.
// `w0` is the older. A kind of KIND_NONE means the slot is empty.
let w0_kind = 0;
let w0_count: int = 0;
let w1_kind = 0;
let w1_count: int = 0;

fn kind_of(c: byte) -> byte {
    if c == '+' { return KIND_ADD; }
    if c == '-' { return KIND_SUB; }
    if c == '>' { return KIND_RIGHT; }
    if c == '<' { return KIND_LEFT; }
    if c == '.' { return KIND_OUT; }
    if c == ',' { return KIND_IN; }
    if c == '[' { return KIND_OPEN; }
    if c == ']' { return KIND_CLOSE; }
    // Everything else is a comment.
    return KIND_NONE;
}

fn foldable(kind: byte) -> bool {
    if kind == KIND_ADD { return true; }
    if kind == KIND_SUB { return true; }
    if kind == KIND_RIGHT { return true; }
    if kind == KIND_LEFT { return true; }
    return false;
}

fn indent() {
    let i = 0;
    while i < depth {
        print("    ");
        i += 1;
    }
}

fn emit(kind: byte, count: int) {
    if kind == KIND_NONE {
        return;
    }
    if kind == KIND_CLOSE {
        depth -= 1;
    }
    indent();

    // The count is printed once, after the chain, rather than in each arm:
    // every `print` of an `int` emits a whole decimal-conversion routine.
    let counted = true;
    if kind == KIND_ADD {
        print("*p += ");
    } else if kind == KIND_SUB {
        print("*p -= ");
    } else if kind == KIND_RIGHT {
        print("p += ");
    } else if kind == KIND_LEFT {
        print("p -= ");
    } else if kind == KIND_CLEAR {
        counted = false;
        println("*p = 0;");
    } else if kind == KIND_OUT {
        counted = false;
        println("putchar(*p);");
    } else if kind == KIND_IN {
        // End of input reads as zero, which is what the interpreters in this
        // workspace do.
        counted = false;
        println("c = getchar(); *p = (c == EOF) ? 0 : (unsigned char) c;");
    } else if kind == KIND_OPEN {
        counted = false;
        println("while (*p) {");
        depth += 1;
    } else {
        counted = false;
        println("}");
    }

    if counted {
        print(count);
        println(";");
    }
}

// Add a unit to the window, writing out whatever falls off the far end.
fn push(kind: byte, count: int) {
    // `[` followed by a single `-` or `+` and then `]` just clears the cell.
    if kind == KIND_CLOSE {
        if w0_kind == KIND_OPEN {
            if w1_count == 1 {
                if w1_kind == KIND_SUB || w1_kind == KIND_ADD {
                    w0_kind = KIND_NONE;
                    w1_kind = KIND_CLEAR;
                    w1_count = 0;
                    return;
                }
            }
        }
    }

    emit(w0_kind, w0_count);
    w0_kind = w1_kind;
    w0_count = w1_count;
    w1_kind = kind;
    w1_count = count;
}

fn prologue() {
    println("/* generated by lobotomy */");
    println("#include <stdio.h>");
    print("static unsigned char tape[");
    print(TAPE_CELLS);
    println("];");
    println("");
    println("int main(void) {");
    println("    unsigned char *p = tape;");
    println("    int c;");
    println("    (void) c;");
}

fn epilogue() {
    if unbalanced {
        println("#error lobotomy: unmatched ] in the Brainfuck source");
    }
    if open_loops != 0 {
        println("#error lobotomy: unmatched [ in the Brainfuck source");
    }
    println("    return 0;");
    println("}");
}

fn main() {
    prologue();

    let run_kind = KIND_NONE;
    let run_count: int = 0;
    // 0 while reading; then counts the passes needed to drain the window.
    let finishing = 0;

    // Every unit goes through the single `push` below. Cranium inlines calls,
    // so one call site rather than four keeps the emitted program small.
    loop {
        let unit_kind = KIND_NONE;
        let unit_count: int = 0;

        if finishing == 0 {
            let c = getc();
            if c == 0 {
                finishing = 1;
            } else {
                let kind = kind_of(c);
                if kind == KIND_NONE {
                    continue;
                }
                if foldable(kind) && kind == run_kind && run_count < RUN_MAX {
                    run_count += 1;
                    continue;
                }
                if kind == KIND_OPEN {
                    open_loops += 1;
                } else if kind == KIND_CLOSE {
                    if open_loops == 0 {
                        unbalanced = true;
                    } else {
                        open_loops -= 1;
                    }
                }
                // The run that just ended is the unit to hand over.
                unit_kind = run_kind;
                unit_count = run_count;
                run_kind = kind;
                run_count = 1;
            }
        }

        if finishing > 0 {
            unit_kind = run_kind;
            unit_count = run_count;
            run_kind = KIND_NONE;
            run_count = 0;
            finishing += 1;
        }

        if unit_kind != KIND_NONE || finishing > 0 {
            push(unit_kind, unit_count);
        }

        if finishing > 3 {
            break;
        }
    }

    epilogue();
}
