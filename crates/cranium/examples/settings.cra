// A settings screen, built from std/tui.cra: tabs, a text field, a menu,
// checkboxes, a volume bar, radio buttons and buttons.
//
//     stty -icanon -echo
//     cranium settings.cra --run
//     stty sane
//
//     tab            move to the next control
//     left / right   switch tabs, or change the volume
//     up / down      choose a theme
//     space, enter   tick a box, pick an option, press a button
//     typing         edits the name
//
// The `stty` hands keys over as they are pressed. Without it the terminal
// collects a line at a time and the program sees them all at once when Enter
// is pressed, which still works but hardly feels like an interface. There is
// no equivalent on Windows, where the console keeps its own line discipline.
//
// Piping keys in works anywhere, and is how this is tested. End of input
// quits, like pressing Quit:
//
//     printf '\t\x7f\x7f\x7fGrace\t\x1b[B\r' | cranium settings.cra --run
//
// HOW IT IS BUILT
//
// There are two functions that matter. `draw` paints the whole screen from the
// program's state, and `handle` changes that state for one key. `main` calls
// them in turn until something sets `running` to false. Nothing remembers what
// is on the screen; every key redraws all of it, which is cheaper on a
// Brainfuck tape than any record of what changed would be.

import "std/tui.cra";

// --------------------------------------------------------------------------
// STATE
// --------------------------------------------------------------------------

// The name field. One longer than the longest name, for the 0 that ends it.
let name: byte[17] = "Ada";

// Which tab is showing: Profile, Sound, About.
let tab: byte = 0;

// Which control on the tab has the focus. 0 is always the tab strip, and Save
// and Quit are always the last two.
let focus: byte = 0;

let theme: byte = 0;
let notifications: bool = true;
let dark: bool = false;
let volume: byte = 6;
let stereo: bool = true;

// Set by pressing Save, and cleared by the next key.
let saved: bool = false;
let running: bool = true;

const PROFILE = 0;
const SOUND = 1;

// How many controls the showing tab has, counting the tab strip.
fn controls() -> byte {
    if tab == PROFILE {
        return 7;
    }
    if tab == SOUND {
        return 6;
    }
    return 3;
}

// --------------------------------------------------------------------------
// DRAWING
// --------------------------------------------------------------------------

// The border colour for the chosen theme.
fn accent() -> byte {
    if theme == 1 {
        return GREEN;
    }
    if theme == 2 {
        return BRIGHT + RED;
    }
    return CYAN;
}

// Text is white on the dark background, and the terminal's own colour
// otherwise, which is the only way to be sure it can be read on a light theme.
fn text_color() {
    if dark {
        ui_fg(BRIGHT + WHITE);
    } else {
        ui_fg(DEFAULT_COLOR);
    }
}

// A small arrow pointing at a control that has the focus but no highlight of
// its own.
fn pointer(column: byte, row: byte) {
    at(column, row);
    // ▸
    print("\xe2\x96\xb8");
}

fn draw_profile() {
    ui_label(5, 5, 12, "Name", ALIGN_LEFT);
    ui_field(18, 5, 20, name, focus == 1);

    ui_label(5, 7, 12, "Theme", ALIGN_LEFT);
    ui_menu(18, 7, 10, "Ocean|Forest|Ember", theme);
    if focus == 2 {
        pointer(16, 7 + theme);
    }

    ui_checkbox(5, 11, "Notifications", notifications, focus == 3);
    ui_checkbox(5, 12, "Dark background", dark, focus == 4);
}

fn draw_sound() {
    ui_label(5, 5, 12, "Volume", ALIGN_LEFT);
    ui_progress(18, 5, 20, volume, 10);
    // The progress bar leaves the cursor at its right-hand end.
    putc(' ');
    print(volume);
    print("/10 ");
    if focus == 1 {
        pointer(16, 5);
    }

    ui_label(5, 7, 12, "Output", ALIGN_LEFT);
    ui_radio(18, 7, "Mono", !stereo, focus == 2);
    ui_radio(18, 8, "Stereo", stereo, focus == 3);
}

fn draw_about() {
    ui_label(3, 6, 48, "Cranium settings", ALIGN_CENTER);
    ui_label(3, 8, 48, "Every character on this screen was put", ALIGN_CENTER);
    ui_label(3, 9, 48, "there by a Brainfuck program.", ALIGN_CENTER);
}

fn draw() {
    if dark {
        ui_bg(BLACK);
    } else {
        ui_bg(DEFAULT_COLOR);
    }
    ui_fg(accent());
    ui_window(2, 1, 50, 15, "Cranium settings", BORDER_ROUNDED);
    ui_divider(2, 3, 50, BORDER_ROUNDED);

    text_color();
    // Bold tabs say that left and right will switch between them.
    if focus == 0 {
        ui_bold();
    }
    ui_tabs(4, 2, "Profile|Sound|About", tab);
    print("\e[22m");

    if tab == PROFILE {
        draw_profile();
    } else if tab == SOUND {
        draw_sound();
    } else {
        draw_about();
    }

    let count = controls();
    ui_button(31, 13, "Save", focus == count - 2);
    ui_button(41, 13, "Quit", focus == count - 1);

    ui_plain();
    if saved {
        ui_status_bar(17, 54, " Saved.");
    } else {
        ui_status_bar(17, 54, " tab next  arrows change  space toggle  enter press");
    }
}

// --------------------------------------------------------------------------
// KEYS
// --------------------------------------------------------------------------

fn pressed(key: byte) -> bool {
    return key == KEY_ENTER || key == ' ';
}

fn handle(key: byte) {
    saved = false;
    // End of input, or Escape: leave as if Quit had been pressed.
    if key == KEY_NONE || key == KEY_ESCAPE {
        running = false;
        return;
    }

    let count = controls();
    if key == KEY_TAB {
        focus += 1;
        if focus == count {
            focus = 0;
        }
        return;
    }

    if focus == 0 {
        tab = ui_tabs_move(tab, key, 3);
        return;
    }
    if focus == count - 1 {
        if pressed(key) {
            running = false;
        }
        return;
    }
    if focus == count - 2 {
        if pressed(key) {
            saved = true;
        }
        return;
    }

    if tab == PROFILE {
        if focus == 1 {
            ui_edit(name, key);
        } else if focus == 2 {
            theme = ui_menu_move(theme, key, 3);
        } else if focus == 3 {
            if pressed(key) {
                notifications = !notifications;
            }
        } else if pressed(key) {
            dark = !dark;
        }
    } else if tab == SOUND {
        if focus == 1 {
            if key == KEY_LEFT && volume != 0 {
                volume -= 1;
            } else if key == KEY_RIGHT && volume != 10 {
                volume += 1;
            }
        } else if focus == 2 {
            if pressed(key) {
                stereo = false;
            }
        } else if pressed(key) {
            stereo = true;
        }
    }
}

fn main() {
    ui_begin();
    while running {
        draw();
        handle(ui_key());
    }
    ui_end();

    print("Goodbye, ");
    puts(name);
    println(".");
}
