// Drawing into an occipital window.
//
// Every function here is a few `putc` calls. That is the whole trick: the
// window reads a program's output as a command stream, so a Cranium program
// draws by printing, and the compiled Brainfuck needs no new instruction.
//
//     import "gfx.cra";

// Introduces a command. Plain bytes are text, so this is what separates
// "draw a pixel" from "print the letter p".
const DLE = 16;

const CMD_LITERAL = 0;
const CMD_CLEAR = 1;
const CMD_COLOR = 2;
const CMD_PLOT = 3;
const CMD_RECT = 4;
const CMD_LINE = 5;
const CMD_PRESENT = 6;
const CMD_PALETTE = 7;
const CMD_AT = 8;
const CMD_QUIT = 9;
const CMD_MODE = 10;

// Screen size. Both fit in a byte, which is the reason for these numbers.
const WIDTH = 256;
const HEIGHT = 192;

// Reads return an event byte instead of a character once this is set.
const MODE_TEXT = 0;
const MODE_EVENTS = 1;

const EV_NONE = 0;
const EV_KEY_DOWN = 1;
const EV_KEY_UP = 2;
const EV_QUIT = 3;

// Keys with no ASCII spelling.
const KEY_UP = 128;
const KEY_DOWN = 129;
const KEY_LEFT = 130;
const KEY_RIGHT = 131;
const KEY_ESCAPE = 132;

// --------------------------------------------------------------------------
// DRAWING
// --------------------------------------------------------------------------

// Set the colour every later shape and character is drawn in.
fn color(c: byte) {
    putc(DLE);
    putc(CMD_COLOR);
    putc(c);
}

// Fill the screen with the current colour and home the text cursor.
fn clear() {
    putc(DLE);
    putc(CMD_CLEAR);
}

fn plot(x: byte, y: byte) {
    putc(DLE);
    putc(CMD_PLOT);
    putc(x);
    putc(y);
}

// Fill a rectangle. Anything past an edge is clipped.
fn rect(x: byte, y: byte, w: byte, h: byte) {
    putc(DLE);
    putc(CMD_RECT);
    putc(x);
    putc(y);
    putc(w);
    putc(h);
}

// Draw a line, both ends included.
fn line(x0: byte, y0: byte, x1: byte, y1: byte) {
    putc(DLE);
    putc(CMD_LINE);
    putc(x0);
    putc(y0);
    putc(x1);
    putc(y1);
}

// Show everything drawn since the last present.
fn present() {
    putc(DLE);
    putc(CMD_PRESENT);
}

// Redefine one palette entry.
fn palette(i: byte, r: byte, g: byte, b: byte) {
    putc(DLE);
    putc(CMD_PALETTE);
    putc(i);
    putc(r);
    putc(g);
    putc(b);
}

// Move the text cursor, in character cells rather than pixels.
fn at(col: byte, row: byte) {
    putc(DLE);
    putc(CMD_AT);
    putc(col);
    putc(row);
}

// Close the window.
fn quit() {
    putc(DLE);
    putc(CMD_QUIT);
}

// --------------------------------------------------------------------------
// COLOUR
//
// The default palette holds a 6x6x6 cube from index 16, so a colour is
// arithmetic rather than a table. Components run 0..5.
// --------------------------------------------------------------------------

fn rgb(r: byte, g: byte, b: byte) -> byte {
    return 16 + 36 * r + 6 * g + b;
}

// The 24 greys above the cube, from 0 (darkest) to 23.
fn grey(level: byte) -> byte {
    return 232 + level;
}

// --------------------------------------------------------------------------
// INPUT
// --------------------------------------------------------------------------

// Switch to non-blocking input. `poll` returns immediately after this.
fn events_mode() {
    putc(DLE);
    putc(CMD_MODE);
    putc(MODE_EVENTS);
}

// Switch back to blocking character input, which is what a program written
// for a terminal expects.
fn text_mode() {
    putc(DLE);
    putc(CMD_MODE);
    putc(MODE_TEXT);
}

// Read one event byte. Returns EV_NONE when nothing has happened, so this is
// safe to call every frame. EV_KEY_DOWN and EV_KEY_UP are each followed by a
// key code, which `poll_key` reads.
fn poll() -> byte {
    return getc();
}

// Read the key code that follows an EV_KEY_DOWN or EV_KEY_UP.
fn poll_key() -> byte {
    return getc();
}
